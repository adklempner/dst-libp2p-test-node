# Phase 5 path C — testnet E2E image (NO local sequencer / risc0).
# Builds logos-logoscore-cli + the wallet & rln modules (clone of logos-lez-rln,
# the Dockerfile.sim recipe minus sequencer/lssa/risc0/delivery/chat), bundles
# our COPY-built Linux libp2p_module .lgx, and bakes the testnet fixtures. The
# CMD drives single-node RLN readiness against https://testnet.lez.logos.co/.
#
# Build context = repo root; expects docker/lp2p-out/libp2p_module.lgx (from
# docker/build_lgx_linux.sh) and the testnet fixtures copied under docker/testnet/.
#
# NOTE: the wallet/rln *.lgx packaging step mirrors logos-chat's sim
# (result-rln / result-wallet nix outputs installed into the modules dir). The
# exact install layout (manifest + variant) is the one open item to validate on
# first run — see single_node_readiness.sh for the driver.
# Ubuntu base + apt build tooling (mirrors logos-chat Dockerfile.sim) — the
# zerokit/lez-rln-ffi cargo build needs build-essential + clang/libclang for
# bindgen, which the bare nixos/nix (alpine) base lacks.
FROM catthehacker/ubuntu:act-latest AS builder
RUN apt-get update -qq && apt-get install -y -qq \
    build-essential pkg-config libssl-dev git curl clang libclang-dev xxd \
    && rm -rf /var/lib/apt/lists/*
RUN curl -L https://nixos.org/nix/install | bash -s -- --daemon --yes
# accept-flake-config=false: ignore flakes' nix-cache.status.im substituter,
# which hangs for untrusted users (the Phase-0 2h+ silent-stall gotcha).
# connect-timeout + fallback so any unreachable substituter fails fast.
RUN mkdir -p /root/.config/nix && \
    printf 'experimental-features = nix-command flakes\nsandbox = false\naccept-flake-config = false\nconnect-timeout = 5\nfallback = true\n' > /root/.config/nix/nix.conf && \
    mkdir -p /etc/nix && cp /root/.config/nix/nix.conf /etc/nix/nix.conf
RUN rmdir /homeless-shelter 2>/dev/null || true
RUN git config --global url."https://github.com/".insteadOf "git@github.com:"
SHELL ["/bin/bash","-lc"]
ENV LIBCLANG_PATH=/usr/lib/llvm-18/lib

# logoscore CLI (the -D / load-module / call daemon binary).
RUN source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh && \
    nix build --no-accept-flake-config --fallback github:logos-co/logos-logoscore-cli -o /logoscore

# Clone logos-lez-rln for the RLN module build (lez-rln-ffi + rln-module are
# overlaid from docker/vendor below). The WALLET module no longer comes from
# here — it is built straight from upstream's flake (see the wallet step). nix
# emits raw lib/include; the daemon needs the .lgx layout (manifest + variant).
RUN source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh && \
    git clone -b feat/rln-stateless-v2.0.2 https://github.com/logos-co/logos-lez-rln.git /root/logos-lez-rln && \
    cd /root/logos-lez-rln && git submodule update --init && \
    rm -rf /root/logos-lez-rln/lssa /root/logos-lez-rln/logos-execution-zone-module /root/logos-lez-rln/logos-rln-module

# Replace the rc3 lssa submodule with upstream execution-zone v0.2.0-rc6
# (e37876a6) — the Rust wallet-ffi fork is GONE; rc6 ships native program_id-based
# generic transactions. Vendored, not pushed — see docker/vendor/lssa.
COPY docker/vendor/lssa/ /root/logos-lez-rln/lssa/

# Wallet module: UPSTREAM logos-execution-zone-module d70225c (rc6) — BOTH the
# Rust wallet-ffi fork and our C++ module fork are DROPPED. Upstream natively
# ships program-id-based send_generic_public_transaction (+ rc6 transfer sigs +
# resolve_public_account); its flake pins execution-zone e37876a6 (rc6), so no
# override is needed. The rln module calls send_generic_public_transaction
# directly with typed multi-arg invokeRemoteMethod (dispatch confirmed).
# Built FIRST (stable input) so rln-side iterations keep it cached.
RUN source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh && \
    nix build --no-accept-flake-config --fallback \
        github:logos-blockchain/logos-execution-zone-module/d70225ced646934d2294fd9e8f8b03615c104b80#lgx \
        -o /root/wallet-lgx

# Patched rln module (RLNDIAG traces) + the lez-rln-ffi PDA-prefix fix: rc5 renamed
# the public-PDA prefix /NSSA/v0.2/AccountId/PDA/ -> /LEE/v0.2/AccountId/PDA/, so the
# rc3-era lez-rln-ffi derived the WRONG tree_main/membership PDAs and registration
# failed at "fetch tree main". The fixed prefix makes lez-rln-ffi derive the same
# PDAs run_setup (rc5 lee) created on-chain.
COPY docker/vendor/logos-rln-module/ /root/logos-lez-rln/logos-rln-module/
COPY docker/vendor/lez-rln-ffi/src/ /root/logos-lez-rln/lez-rln/lez-rln-ffi/src/

RUN source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh && \
    cd /root/logos-lez-rln && \
    nix bundle --no-accept-flake-config --fallback \
        --bundler github:logos-co/nix-bundle-lgx .#logos-rln-module -o /root/rln-bundle

# Runtime tools into a dedicated profile so the CMD needs no `nix` at runtime.
RUN source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh && \
    nix profile install --no-accept-flake-config --fallback --profile /rttools \
      nixpkgs#bash nixpkgs#python3 nixpkgs#coreutils nixpkgs#gnutar nixpkgs#gnugrep nixpkgs#curl nixpkgs#procps
ENV PATH=/rttools/bin:$PATH

# Our Linux RLN-enabled module + driver.
COPY docker/lp2p-out/libp2p_module.lgx /artifacts/libp2p_module.lgx
COPY docker/testnet/single_node_readiness.sh /driver.sh
RUN chmod +x /driver.sh
# rc6 testnet fixtures (config/payment/supply + rc6-format storage.json.seed +
# wallet_config + env), generated by the rc6 run_setup against the redeployed
# testnet (RLN program + tree re-provisioned there under tree_id ccddeeff…).
COPY docker/testnet/fixtures-rc6/ /testnet/

# Install all three modules the way logos-core expects: <mdir>/<manifest.name>/
# with manifest.json + flattened variant libs + a `variant` marker (mirrors the
# sim's install_lgx). rln/wallet .lgx come from the nix bundles; libp2p from our
# COPY'd artifact. Variant key auto-detected (single per-platform variant).
RUN mkdir -p /modules && \
    rlnlgx=$(find -L /root/rln-bundle -maxdepth 2 -name '*.lgx' | head -1) && \
    walletlgx=$(find -L /root/wallet-lgx -maxdepth 2 -name '*.lgx' | head -1) && \
    [ -f "$rlnlgx" ] && [ -f "$walletlgx" ] || { echo "missing .lgx (rln=$rlnlgx wallet=$walletlgx)"; exit 1; } && \
    for lgx in /artifacts/libp2p_module.lgx "$rlnlgx" "$walletlgx"; do \
        name=$(tar xzOf "$lgx" manifest.json | python3 -c 'import json,sys;print(json.load(sys.stdin)["name"])') && \
        tmp=$(mktemp -d) && tar xzf "$lgx" -C "$tmp" && \
        var=$(ls "$tmp/variants" | head -1) && \
        rm -rf "/modules/$name" && mkdir -p "/modules/$name" && \
        cp "$tmp/manifest.json" "/modules/$name/" && \
        cp -L "$tmp/variants/$var/"* "/modules/$name/" && \
        printf '%s' "$var" > "/modules/$name/variant" && \
        echo "installed $name (variant=$var)"; \
    done

ENV LOGOSCORE=/logoscore/bin/logoscore MODULES_DIR=/modules WALLET_HOME=/testnet
CMD ["bash","/driver.sh"]
